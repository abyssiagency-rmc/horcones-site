---
const season = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-body">
      <div class="footer-brand">
        <a class="footer-logo" href="/" aria-label="Horcones RC · Ir al inicio">
          <img src="/images/logo-horcones.png" alt="" width="280" height="198" />
        </a>
        <p class="footer-tagline">Rugby, comunidad y pertenencia.</p>
      </div>

      <nav class="footer-links" aria-label="Enlaces del sitio">
        <div class="footer-group">
          <h2>Club</h2>
          <a href="/club">El Club</a>
          <a href="/equipos">Equipos</a>
          <a href="/partidos">Partidos</a>
          <a href="/eventos">Eventos</a>
          <a href="/comunidad">Comunidad</a>
        </div>
        <div class="footer-group">
          <h2>Sitio</h2>
          <a href="/noticias">Noticias</a>
          <a href="/videos">Videos</a>
          <a href="/tienda">Tienda</a>
          <a href="/tickets">Tickets</a>
        </div>
        <div class="footer-group">
          <h2>Participa</h2>
          <a href="/sumate">Súmate</a>
          <a href="/auspicios">Auspicios</a>
        </div>
      </nav>

      <div class="footer-contact">
        <p class="footer-contact-label" id="footer-contacto">Contacto</p>
        <a
          class="footer-mail"
          href="mailto:contacto@horconesrc.cl?subject=Contacto%20Horcones"
          aria-describedby="footer-contacto"
        >
          <span class="footer-mail-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg>
          </span>
          <span class="footer-mail-copy">
            <strong>contacto@horconesrc.cl</strong>
            <small>Auspicios · Prensa · Postulaciones</small>
          </span>
        </a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <span>© {season} Horcones RC</span>
    <div class="footer-legal">
      <a href="/privacidad">Privacidad</a>
      <span aria-hidden="true">·</span>
      <a href="/terminos">Términos</a>
      <span aria-hidden="true">·</span>
      <a href="/devoluciones">Devoluciones</a>
    </div>
  </div>
</footer>
