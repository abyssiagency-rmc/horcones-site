---
import { fixtures, nextMatch, standings } from "../data/match";

const topThree = standings.filter((fila) => fila.pos >= 3 && fila.pos <= 5);
---

<section class="match-section" aria-labelledby="match-title">
  <div class="section-wrap">
    <header class="match-top">
      <div class="match-title-block">
        <p class="section-kicker">Próximo partido</p>
        <h2 id="match-title">Nos vemos en la cancha.</h2>
      </div>
    </header>

    <div class="match-cards">
      <article class="next-match-card">
        <div class="next-match-top">
          <span>{nextMatch.competicion}</span>
          <span>{nextMatch.dia}</span>
        </div>
        <div class="next-match-clubs">
          <div class="next-club">
            <div class="next-crest">
              <img src="/images/logo-horcones.png" alt="Escudo de Horcones RC" />
            </div>
            <p class="next-label">{nextMatch.localLabel}</p>
            <h3>{nextMatch.local}</h3>
          </div>
          <span class="next-vs" aria-hidden="true">VS</span>
          <div class="next-club">
            <div class="next-crest next-crest--placeholder" aria-hidden="true">?</div>
            <p class="next-label">{nextMatch.visitanteLabel}</p>
            <h3>{nextMatch.visitante}</h3>
          </div>
        </div>
        <div class="next-match-footer">
          <strong>{nextMatch.hora}</strong>
          <span>{nextMatch.sede}</span>
        </div>
      </article>

      {fixtures.slice(0, 2).map((partido, index) => (
        <a class="upcoming-card" href="/partidos">
          <div class="upcoming-top">
            <span>{partido.competicion}</span>
            <span>{partido.fecha}</span>
          </div>
          <div class="upcoming-date">
            <strong>{String(index + 4).padStart(2, "0")}</strong>
            <span>Fecha por confirmar</span>
          </div>
          <div class="upcoming-matchup">
            <h4>{partido.local}</h4>
            <span aria-hidden="true">vs</span>
            <h4>{partido.visita}</h4>
          </div>
          <p class="upcoming-meta">{partido.condicion} · {partido.sede}</p>
          <span class="upcoming-link">Ver información <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>

    <div class="fixture-footer-link">
      <a class="section-link" href="/partidos">Ver calendario <span aria-hidden="true">→</span></a>
    </div>

    <section class="standings standings--home" aria-labelledby="standings-title">
      <header class="standings-head">
        <div>
          <p class="section-kicker">Central ARUMET 2026</p>
          <h3 id="standings-title">Tabla de posiciones</h3>
        </div>
        <a class="section-link" href="/partidos">Ver tabla completa <span aria-hidden="true">→</span></a>
      </header>

      <div class="table-scroll">
        <table>
          <caption class="sr-only">Tabla parcial de posiciones del Central ARUMET 2026</caption>
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Equipo</th>
              <th scope="col">Pts</th>
              <th scope="col">PJ</th>
              <th scope="col">PF</th>
              <th scope="col">PC</th>
              <th scope="col">DP</th>
            </tr>
          </thead>
          <tbody>
            {topThree.map((fila) => (
              <tr class:list={fila.equipo === "Horcones RC" && "is-horcones"}>
                <td>{fila.pos}</td>
                <th scope="row">{fila.equipo}</th>
                <td class="pts">{fila.pts}</td>
                <td>{fila.pj}</td>
                <td>{fila.pf}</td>
                <td>{fila.pc}</td>
                <td class="dp">{fila.dp}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</section>
