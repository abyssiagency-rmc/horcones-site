---
import { heroSlides } from "../data/hero";
---

<section class="hero" aria-roledescription="carrusel" aria-label="Historias del club" data-hero>
  <h1 class="sr-only">Horcones RC · Rugby, comunidad y pertenencia</h1>
  <div class="hero-slides">
    {heroSlides.map((slide, index) => (
      <article
        class:list={["hero-slide", `hero-slide--${slide.layout}`, index === 0 && "is-active"]}
        data-slide
        aria-roledescription="slide"
        aria-label={`${index + 1} de ${heroSlides.length}`}
        aria-hidden={index !== 0}
        inert={index !== 0}
      >
        {slide.layout === "full" ? (
          <img
            class="hero-bg"
            src={slide.image}
            alt={slide.imageAlt}
            style={`object-position:${slide.position}`}
            loading={index === 0 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : "auto"}
          />
        ) : null}
        <div class="hero-scrim" aria-hidden="true"></div>
        <div class="hero-inner">
          <div class="hero-copy">
            <p class="hero-eyebrow">{slide.eyebrow}</p>
            <h2>{slide.title}</h2>
            {slide.body ? <p class="hero-body">{slide.body}</p> : null}
            <div class="hero-actions">
              <a class="btn btn-primary" href={slide.ctaHref}>{slide.ctaLabel}</a>
              {slide.secondaryLabel ? (
                <a class="btn btn-ghost" href={slide.secondaryHref}>{slide.secondaryLabel}</a>
              ) : null}
            </div>
          </div>
          {slide.layout === "shop" ? (
            <div class="hero-shop-media">
              <img src={slide.image} alt={slide.imageAlt} loading="lazy" style={`object-position:${slide.position}`} />
            </div>
          ) : null}
        </div>
      </article>
    ))}
  </div>

  <div class="hero-controls">
    <div class="hero-dots" role="tablist" aria-label="Elegir slide">
      {heroSlides.map((slide, index) => (
        <button
          class:list={["hero-dot", index === 0 && "is-active"]}
          type="button"
          role="tab"
          aria-selected={index === 0}
          aria-label={`Ir al slide ${index + 1}: ${slide.eyebrow}`}
          data-hero-dot
          data-index={index}
        ></button>
      ))}
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  if (hero) {
    const slides = Array.from(hero.querySelectorAll<HTMLElement>("[data-slide]"));
    const dots = Array.from(hero.querySelectorAll<HTMLButtonElement>("[data-hero-dot]"));
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    let current = 0;
    let timer = 0;
    let manual = false;

    const setSlide = (next: number) => {
      current = (next + slides.length) % slides.length;
      slides.forEach((slide, index) => {
        const active = index === current;
        slide.classList.toggle("is-active", active);
        slide.setAttribute("aria-hidden", String(!active));
        if ("inert" in slide) (slide as HTMLElement & { inert: boolean }).inert = !active;
        else slide.toggleAttribute("inert", !active);
      });
      dots.forEach((dot, index) => {
        dot.classList.toggle("is-active", index === current);
        dot.setAttribute("aria-selected", String(index === current));
      });
    };

    const stop = () => {
      window.clearInterval(timer);
      timer = 0;
    };

    const start = () => {
      stop();
      if (manual || reduced.matches) return;
      timer = window.setInterval(() => setSlide(current + 1), 4500);
    };

    dots.forEach((dot) => dot.addEventListener("click", () => {
      manual = true;
      stop();
      setSlide(Number(dot.dataset.index));
    }));

    hero.addEventListener("pointerenter", stop);
    hero.addEventListener("pointerleave", () => {
      if (!manual) start();
    });
    hero.addEventListener("focusin", stop);
    hero.addEventListener("focusout", (event) => {
      if (!hero.contains(event.relatedTarget as Node) && !manual) start();
    });
    hero.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        manual = true;
        stop();
        setSlide(current - 1);
      }
      if (event.key === "ArrowRight") {
        manual = true;
        stop();
        setSlide(current + 1);
      }
    });

    let touchStart = 0;
    hero.addEventListener("touchstart", (event) => {
      touchStart = event.touches[0]?.clientX ?? 0;
    }, { passive: true });
    hero.addEventListener("touchend", (event) => {
      const delta = (event.changedTouches[0]?.clientX ?? 0) - touchStart;
      if (Math.abs(delta) > 45) {
        manual = true;
        stop();
        setSlide(current + (delta < 0 ? 1 : -1));
      }
    }, { passive: true });

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
      else if (!manual) start();
    });

    reduced.addEventListener?.("change", () => {
      if (reduced.matches) stop();
      else if (!manual) start();
    });

    setSlide(0);
    start();
  }
</script>
