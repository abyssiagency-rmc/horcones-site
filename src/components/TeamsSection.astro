---
const equipos = [
  {
    numero: "01",
    nombre: "Primer Equipo",
    kicker: "Rugby 15s · ARUMET",
    descripcion: "El equipo que representa al club en la cancha.",
    href: "/equipos#primer-equipo",
    destacado: true,
  },
  {
    numero: "02",
    nombre: "Intermedia",
    kicker: "Formación y competencia",
    descripcion: "El puente entre las formativas y la primera.",
    href: "/equipos#intermedia",
  },
  {
    numero: "03",
    nombre: "Femenina",
    kicker: "Rugby femenino",
    descripcion: "Un espacio para desarrollar y competir.",
    href: "/equipos#femenina",
  },
  {
    numero: "04",
    nombre: "Juveniles",
    kicker: "Formación",
    descripcion: "Trabajo técnico, físico y de valores.",
    href: "/equipos#juveniles",
  },
  {
    numero: "05",
    nombre: "Infantiles",
    kicker: "Escuela",
    descripcion: "El primer contacto con el rugby.",
    href: "/equipos#infantiles",
  },
];
---

<section class="teams-section" aria-labelledby="teams-title">
  <div class="section-wrap">
    <header class="section-head">
      <div>
        <p class="section-kicker">Equipos</p>
        <h2 id="teams-title">Un club, todas las edades.</h2>
      </div>
      <a class="section-link" href="/equipos">Ver equipos <span aria-hidden="true">→</span></a>
    </header>

    <div class="teams-grid">
      {equipos.map((equipo) => (
        <a class:list={["team-card", equipo.destacado && "team-card--feature"]} href={equipo.href}>
          <span class="team-index">{equipo.numero}</span>
          <div class="team-body">
            <p class="team-kicker">{equipo.kicker}</p>
            <h3>{equipo.nombre}</h3>
            <p class="team-description">{equipo.descripcion}</p>
          </div>
          <span class="team-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</section>
