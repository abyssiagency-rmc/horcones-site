---
import Layout from "../layouts/Layout.astro";

export function getStaticPaths() {
  const secciones = [
  { slug: "club", title: "El Club", eyebrow: "Identidad", copy: "Historia, valores y significado de los colores albirrojos." },
  { slug: "equipos", title: "Equipos", eyebrow: "Categorías", copy: "Primer Equipo, Intermedia, Femenina, Juveniles e Infantiles." },
  { slug: "partidos", title: "Partidos", eyebrow: "Fixture", copy: "Calendario, resultados y próximos desafíos." },
  { slug: "eventos", title: "Eventos", eyebrow: "Vida de club", copy: "Tercer tiempo, cenas, clínicas y actividades de la comunidad." },
  { slug: "noticias", title: "Noticias", eyebrow: "Actualidad", copy: "Crónicas, comunicados y novedades del club." },
  { slug: "comunidad", title: "Comunidad", eyebrow: "Pertenencia", copy: "Las personas que hacen posible el club." },
  { slug: "tienda", title: "Tienda", eyebrow: "Tienda oficial", copy: "Indumentaria y campañas del club." },
  { slug: "tickets", title: "Tickets", eyebrow: "Eventos comprables", copy: "Todos los partidos y eventos con venta de entradas." },
  { slug: "auspicios", title: "Auspicios", eyebrow: "Auspiciadores", copy: "Propuesta para empresas que quieren acompañar al club." },
  { slug: "sumate", title: "Súmate", eyebrow: "Nuevos integrantes", copy: "Cómo sumarse al club, categorías y días de entrenamiento." },
  ];
  return secciones.map((seccion) => ({
    params: { seccion: seccion.slug },
    props: { seccion },
  }));
}

const { seccion } = Astro.props;

const title = `${seccion.title} · Horcones RC`;
---

<Layout title={title} description={seccion.copy}>
  <section class="placeholder">
    <p class="placeholder-eyebrow">{seccion.eyebrow}</p>
    <h1>{seccion.title}</h1>
    <p>{seccion.copy}</p>
    <p class="placeholder-note">Sección en construcción. Siguiente rebanada de diseño.</p>
    <a class="btn btn-primary" href="/">Volver al inicio</a>
  </section>
</Layout>
